<?xml version="1.0" encoding="UTF-8"?>
<!--
  desktop: the "frontend". JavaFX screens only.

  Rule for this module: no money math and no file handling. Everything goes
  through core's FinanceService.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.finance.runwayd</groupId>
        <artifactId>runwayd-parent</artifactId>
        <version>1.0.1</version>
    </parent>

    <artifactId>desktop</artifactId>

    <properties>
        <!-- See the surefire note below: true runs the QA tests invisibly. -->
        <qa.headless>true</qa.headless>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.finance.runwayd</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-junit5</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>openjfx-monocle</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- version.properties gets the version, update repo and Team ID filled in; everything else is copied as is. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/*.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>**/*.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <!--
              The QA tests (src/test/.../qa) open the real window and click through it. They run invisibly
              (Monocle's headless mode) so a build never takes over the screen. To watch them instead:
                mvn -pl desktop test -Dqa.headless=false
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <qa.headless>${qa.headless}</qa.headless>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- Lets you start the app with: mvn -pl desktop javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.finance.runwayd.desktop.Launcher</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
